# ── Only key you need for Phase 1 ─────────────────────
OPENAI_API_KEY=sk-...

# ── Phase 2: Free providers ────────────────────────────
# Groq — free, ultra fast (500+ tokens/sec)
# Get key: https://console.groq.com
GROQ_API_KEY=gsk_...

# Gemini — free tier (15 req/min)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AI...

# HuggingFace — free inference API
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...

# ── App ───────────────────────────────────────────────
APP_NAME="RAG Gateway"
APP_ENV=development
DEBUG=true
GATEWAY_API_KEY=dev-secret-key

# ── Embeddings (local, free — no key needed) ──────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── ChromaDB (local, free) ────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=rag_docs

# ── RAG settings ──────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# ── OpenAI generation ─────────────────────────────────
GENERATION_MODEL=gpt-4o-mini
MAX_TOKENS=1024
TEMPERATURE=0.2

# ── Phase 5: Cache ─────────────────────────────────────────────
# "local"          → in-memory, no Redis needed (good for dev)
# "redis"          → exact match cache (needs Redis running)
# "redis-semantic" → fuzzy match cache (needs Redis + embedding)
CACHE_TYPE=local

# Redis (only if CACHE_TYPE=redis or redis-semantic)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# How long to keep a cached response
CACHE_TTL=3600

# 0.90 = reuse if 90% similar (recommended)
SEMANTIC_SIMILARITY_THRESHOLD=0.90

# Aliases to never cache (always call LLM fresh)
CACHE_DISABLED_ALIASES=["reasoning"]


# ── Phase 6: Load Balancing ────────────────────────────────────
# Routing strategy across models with the same alias
# Options: simple-shuffle | least-busy | usage-based-routing
#          latency-based-routing | weighted-pick
ROUTING_STRATEGY=usage-based-routing

# Circuit breaker: fail N times → mark model unhealthy
ALLOWED_FAILS=3

# Seconds to wait before retrying a failed/rate-limited model
COOLDOWN_TIME=60

# Retries within same model before switching to fallback
NUM_RETRIES=2

# Per-request timeout in seconds
REQUEST_TIMEOUT=30